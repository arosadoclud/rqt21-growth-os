# --- Backend ---
DATABASE_URL=postgresql+psycopg://rqt:rqt@localhost:5432/rqt
TEST_DATABASE_URL=postgresql+psycopg://rqt:rqt@localhost:5433/rqt_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-please-use-a-64-byte-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Comma-separated list of origins allowed to hit the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Cookies: set to "true" only when the API is served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax  # lax | strict | none (none REQUIRES COOKIE_SECURE=true)

# Rate limiting (per sliding window)
RL_LOGIN_IP_LIMIT=10
RL_LOGIN_EMAIL_LIMIT=5
RL_LOGIN_WINDOW_SECONDS=60
RL_REFRESH_IP_LIMIT=60
RL_REFRESH_WINDOW_SECONDS=60

# Comma-separated hostnames allowed by TrustedHost middleware.
# Use "*" for local dev only; set explicit hosts in production.
TRUSTED_HOSTS=*
ENVIRONMENT=development  # switch to "production" to enable HSTS

# Seed
SEED_OWNER_EMAIL=owner@rqt21.dev
SEED_OWNER_PASSWORD=Owner!2026Local
SEED_OWNER_NAME=RQT21 Owner
SEED_ORG_NAME=RQT21
SEED_ORG_SLUG=rqt21

# --- Phase 6A: distributed infra (all optional; empty = same behavior as
# Phases 1-5) — see .env.staging.example / .env.production.example for the
# full set filled in for a real deployment.
REDIS_URL=
QUEUE_BACKEND=inline        # inline | redis
SCHEDULER_BACKEND=memory    # memory | redis
ERROR_REPORTER=none         # none | sentry
SENTRY_DSN=
SECRETS_PROVIDER=env        # env | aws-secrets-manager
LOG_FORMAT=text              # text | json

# Storage (Phase 5 MOCK/LOCAL by default; S3/R2 real in staging/prod)
STORAGE_PROVIDER=LOCAL      # LOCAL | MOCK | S3 | R2
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=            # only for R2 — e.g. https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Meta OAuth + publishing (Phase 6B fills these in — see README "Fase 6B")
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_PUBLISHING_ENABLED=false

# --- Frontend ---
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
