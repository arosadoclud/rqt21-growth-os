# Copy to .env.production (gitignored) and fill in real values — Phase 6B.
# Unlike staging, DATABASE_URL and REDIS_URL point at managed services —
# there are no db/redis containers in docker-compose.prod.yml.

PUBLIC_API_URL=https://api.example.com

DATABASE_URL=postgresql+psycopg://user:password@your-managed-postgres-host:5432/rqt
JWT_SECRET=generate-with-python -c "import secrets; print(secrets.token_urlsafe(64))"
CORS_ORIGINS=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=api.example.com
ENVIRONMENT=production

REDIS_URL=rediss://your-managed-redis-host:6380/0
QUEUE_BACKEND=redis
SCHEDULER_BACKEND=redis

STORAGE_PROVIDER=R2
STORAGE_BUCKET=rqt21-prod-assets
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CREDENTIALS_ENCRYPTION_KEY=generate-a-separate-64-byte-random-string-different-from-staging

META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/oauth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_PUBLISHING_ENABLED=false

ERROR_REPORTER=sentry
SENTRY_DSN=
LOG_FORMAT=json

# Production seed is intentionally NOT run automatically — see
# infra/scripts/README.md. Never point production at demo/seed data.
