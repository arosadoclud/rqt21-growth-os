# Copy to .env.staging (gitignored) and fill in real values — Phase 6B.
# This file lives at the repo root; infra/docker-compose.staging.yml reads
# it via --env-file.

POSTGRES_PASSWORD=change-me-to-a-real-random-password
PUBLIC_API_URL=https://api-staging.example.com

DATABASE_URL=postgresql+psycopg://rqt:change-me-to-a-real-random-password@db:5432/rqt
JWT_SECRET=generate-with-python -c "import secrets; print(secrets.token_urlsafe(64))"
CORS_ORIGINS=https://staging.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUSTED_HOSTS=api-staging.example.com
ENVIRONMENT=staging

REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=redis
SCHEDULER_BACKEND=redis

STORAGE_PROVIDER=R2
STORAGE_BUCKET=rqt21-staging-assets
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CREDENTIALS_ENCRYPTION_KEY=generate-a-separate-64-byte-random-string

META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://api-staging.example.com/api/v1/oauth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_PUBLISHING_ENABLED=false

ERROR_REPORTER=sentry
SENTRY_DSN=
LOG_FORMAT=json

SEED_OWNER_EMAIL=owner@rqt21.dev
SEED_OWNER_PASSWORD=change-me
